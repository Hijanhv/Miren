# Dhan broker (only needed for LIVE mode). Never commit real values.
DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token
# Leave unset for real trading. Set to https://sandbox.dhan.co/v2 with sandbox keys
# from developer.dhanhq.co to test LIVE mode with virtual money.
# DHAN_API_BASE_URL=https://sandbox.dhan.co/v2

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8001

# Optional tuning
# MIREN_TICK_SECONDS=300            # detection loop interval
# MIREN_MIN_SWITCH_CONFIDENCE=0.6   # below this HMM confidence a regime change is logged, not acted on
# MIREN_DETECT_WINDOW=500           # daily feature rows the HMM is fit on
# MIREN_DEFAULT_SYMBOL=^NSEI
# CORS_ORIGINS=https://your-app.vercel.app
